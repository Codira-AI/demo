# Tessera environment.
#
# Default values below run the demo end-to-end with zero account
# setup — DEMO_MODE=true means Clerk / Stripe / Resend are all
# mocked in-process. The only real piece is Postgres (via Docker).
#
# To run against real services, set DEMO_MODE=false and fill in
# the production keys for each integration you want live. The
# code paths are identical either way; the mock switches happen
# inside src/lib/{auth,billing,email}.ts.

# ─── Core ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tessera"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_MODE="true"

# ─── Clerk (only used when DEMO_MODE=false) ──────────────────────
# Get keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# ─── Stripe (only used when DEMO_MODE=false) ─────────────────────
# Get keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# For local webhook testing: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""

# ─── Resend (only used when DEMO_MODE=false) ─────────────────────
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender — use onboarding@resend.dev for testing.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ─── Sentry (optional; only used when DSN is set) ────────────────
NEXT_PUBLIC_SENTRY_DSN=""
